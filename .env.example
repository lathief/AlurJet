# Example only; replace all tokens before running the service.
ALURJET_HTTP_ADDR=:8080
ALURJET_MYSQL_HOST=mysql
ALURJET_MYSQL_PORT=3306
ALURJET_MYSQL_DATABASE=alurjet
ALURJET_MYSQL_USER=alurjet
ALURJET_MYSQL_PASSWORD=replace-with-local-db-password
ALURJET_MYSQL_ROOT_PASSWORD=replace-with-separate-local-root-password
ALURJET_ADMIN_API_KEY=replace-with-long-random-admin-token
ALURJET_WEBHOOK_TOKENS_JSON='{"order-to-api":"replace-with-long-random-webhook-token"}'

# Compose demo only. Outside the demo, use an HTTPS origin and leave the exception empty.
ALURJET_FLOW_TARGET_URL=http://mock-api:8081
ALURJET_ALLOWED_ORIGINS=http://mock-api:8081
ALURJET_DEV_PRIVATE_ORIGIN=http://mock-api:8081
ALURJET_MOCK_MODE=success
ALURJET_MOCK_PORT=8081
ALURJET_WORKER_POLL_INTERVAL=2s
ALURJET_WORKER_ATTEMPT_TIMEOUT=15s
ALURJET_WORKER_LEASE_DURATION=60s
ALURJET_MAX_PAYLOAD_BYTES=1048576
ALURJET_MAX_OUTBOUND_BYTES=1048576
ALURJET_MAX_RESPONSE_HEADER_BYTES=65536
ALURJET_MAX_ACTIVE_PER_FLOW=250
ALURJET_MAX_FLOW_YAML_BYTES=65536
ALURJET_WORKER_CONCURRENCY=4
ALURJET_WORKER_RECOVERY_INTERVAL=15s
ALURJET_WORKER_RECOVERY_BATCH=50
ALURJET_MYSQL_MAX_OPEN_CONNS=20
ALURJET_SHUTDOWN_TIMEOUT=20s
ALURJET_LOG_LEVEL=info

# Optional: used by flows that define `headers` (see docs/examples/order-to-api-auth.yaml).
# API and worker must receive the same value. Never commit a real token.
ALURJET_FLOW_TARGET_TOKEN=replace-with-target-api-token
